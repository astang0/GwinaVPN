<?xml version="1.0" encoding="utf-8"?>
<!-- Created in 11/2024 by Anthony Stang  -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0"
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="windows" namespace="AlwaysOnVPN.Policies.Common" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>

      <!--At
      least Windows Threshold no SERVER Enterprise-->
      <definition name="SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION"
        displayName="$(string.SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION)">
        <or>
          <range ref="products:MicrosoftWindows" minVersionIndex="14" maxVersionIndex="14" />
        </or>
      </definition>
      <!--At
      least Windows 11 22H2 Enterprise or Education -->
      <definition name="SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION"
        displayName="$(string.SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION)">
        <or>
          <range ref="products:MicrosoftWindows" minVersionIndex="16" maxVersionIndex="16" />
        </or>
      </definition>

    </definitions>
  </supportedOn>

  <categories>
    <category
      name="AOVPN" 
      displayName="$(string.AOVPN_Name)"
      explainText="$(string.AOVPN_Explain)">
    </category>
    <category name="DeviceTunnel" 
    displayName="$(string.DeviceTunnel_Name)" 
    explainText="$(string.DeviceTunnel_Explain)">
      <parentCategory ref="AOVPN" />
    </category>
    <category name="AllUserConnection" 
    displayName="$(string.AllUserConnection_Name)"
    explainText="$(string.AllUserConnection_Explain)">
      <parentCategory ref="AOVPN" />
    </category>
  </categories>


  <policies>

    <!--  Set DNS-Suffix DT  -->
    <policy
      name="DNSSuffixDT"
      class="Machine"
      displayName="$(string.DNSSuffix_Name)"
      explainText="$(string.DNSSuffix_Explain)"
      presentation="$(presentation.DNSSuffix)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <text id="DNSSuffixTextBox" valueName="DNSSuffix" required="true" />
      </elements>
    </policy>

    <!--  DNS-Suffixes for Trusted Network Detection DT  -->
    <policy
      name="TrustedNetworkDetectionDT"
      class="Machine"
      displayName="$(string.TrustedNetworkDetection_Name)"
      explainText="$(string.TrustedNetworkDetection_Explain)"
      presentation="$(presentation.TrustedNetworkDetection)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="TrustedNetworks" valueName="TrustedNetworkDetection" required="true" />
      </elements>
    </policy>

    <!--  Enable/Disable DisconnectButton DT   -->

    <policy
      name="DisableDisconnectButtonDT"
      class="Machine"
      displayName="$(string.DisableDisconnectButton_Name)"
      explainText="$(string.DisableDisconnectButton_Explain)"
      presentation="$(presentation.DisableDisconnectButton)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
      valueName="DisableDisconnectButton">

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION" />
      <enabledValue>
        <string>true</string>
      </enabledValue>
      <disabledValue>
        <string>false</string>
      </disabledValue>
    </policy>

    <!--  Enable/Disable Show DT in UI  -->

    <policy
      name="ShowDeviceTunnelInUIDT"
      class="Machine"
      displayName="$(string.ShowDeviceTunnelInUI_Name)"
      explainText="$(string.ShowDeviceTunnelInUI_Explain)"
      presentation="$(presentation.ShowDeviceTunnelInUI)"
      key="SOFTWARE\Microsoft\Flyout\VPN"
      valueName="ShowDeviceTunnelInUI">

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>


    <!--  Enable/Disable Advanced Option Button  DT -->

    <policy
      name="DisableAdvancedOptionsEditButtonDT"
      class="Machine"
      displayName="$(string.DisableAdvancedOptionsEditButton_Name)"
      explainText="$(string.DisableAdvancedOptionsEditButton_Explain)"
      presentation="$(presentation.DisableAdvancedOptionsEditButton)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
      valueName="DisableAdvancedOptionsEditButton">

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION" />
      <enabledValue>
        <string>true</string>
      </enabledValue>
      <disabledValue>
        <string>false</string>
      </disabledValue>
    </policy>

    <!--  Enable/Disable Class Based Default Route DT   

    <policy
      name="DisableClassBasedDefaultRouteDT"
      class="Machine"
      displayName="$(string.DisableClassBasedDefaultRoute_Name)"
      explainText="$(string.DisableClassBasedDefaultRoute_Explain)"
      presentation="$(presentation.DisableClassBasedDefaultRoute)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
      valueName="DisableClassBasedDefaultRoute">

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />

      <enabledValue>
        <string>true</string>
      </enabledValue>
      <disabledValue>
        <string>false</string>
      </disabledValue>
    </policy> -->

    <!--  Enable/Disable Register DNS DT   -->

    <policy
      name="RegisterDNSDT"
      class="Machine"
      displayName="$(string.RegisterDNS_Name)"
      explainText="$(string.RegisterDNS_Explain)"
      presentation="$(presentation.RegisterDNS)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
      valueName="RegisterDNS">

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />

      <enabledValue>
        <string>false</string>
      </enabledValue>
      <disabledValue>
        <string>true</string>
      </disabledValue>
    </policy>

    <!--  VPN-Servers  DT-->
    <policy
      name="ServersDT"
      class="Machine"
      displayName="$(string.Servers_Name)"
      explainText="$(string.Servers_Explain)"
      presentation="$(presentation.Servers)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <text id="Servers" valueName="Servers" required="true" />
      </elements>
    </policy>


    <!--  IPsec Settings DT-->
    <policy
      name="IKEv2SettingsDT"
      class="Machine"
      displayName="$(string.IKEv2Settings_Name)"
      explainText="$(string.IKEv2Settings_Explain)"
      presentation="$(presentation.IKEv2Settings)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <enum id="IntegrityCheckMethod_DropDown" valueName="IntegrityCheckMethod" required="true">
          <item displayName="$(string.dropdown_MD5)">
            <value>
              <string>MD5</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_SHA256)">
            <value>
              <string>SHA256</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_SHA384)">
            <value>
              <string>SHA384</string>
            </value>
          </item>
        </enum>
        <enum id="EncryptionMethod_DropDown" valueName="EncryptionMethod" required="true">
          <item displayName="$(string.dropdown_DES)">
            <value>
              <string>DES</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_DES3)">
            <value>
              <string>DES3</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES128)">
            <value>
              <string>AES128</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES192)">
            <value>
              <string>AES192</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES256)">
            <value>
              <string>AES256</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES_GCM_128)">
            <value>
              <string>AES_GCM_128</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES_GCM_256)">
            <value>
              <string>AES_GCM_256</string>
            </value>
          </item>
        </enum>
        <enum id="AuthenticationTransformConstants_DropDown"
          valueName="AuthenticationTransformConstants" required="true">
          <item displayName="$(string.dropdown_MD596)">
            <value>
              <string>MD596</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_SHA196)">
            <value>
              <string>SHA196</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_SHA256128)">
            <value>
              <string>SHA256128</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_GCMAES128)">
            <value>
              <string>GCMAES128</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_GCMAES192)">
            <value>
              <string>GCMAES192</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_GCMAES256)">
            <value>
              <string>GCMAES256</string>
            </value>
          </item>
        </enum>
        <enum id="CipherTransformConstants_DropDown" valueName="CipherTransformConstants"
          required="true">
          <item displayName="$(string.dropdown_DES)">
            <value>
              <string>DES</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_DES3)">
            <value>
              <string>DES3</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES128)">
            <value>
              <string>AES128</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES192)">
            <value>
              <string>AES192</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_AES256)">
            <value>
              <string>AES256</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_GCMAES128)">
            <value>
              <string>GCMAES128</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_GCMAES192)">
            <value>
              <string>GCMAES192</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_GCMAES256)">
            <value>
              <string>GCMAES256</string>
            </value>
          </item>
        </enum>
        <enum id="PfsGroup_DropDown" valueName="PfsGroup" required="true">
          <item displayName="$(string.dropdown_PFS1)">
            <value>
              <string>PFS1</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_PFS2)">
            <value>
              <string>PFS2</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_PFS2048)">
            <value>
              <string>PFS2048</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_ECP256)">
            <value>
              <string>ECP256</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_ECP384)">
            <value>
              <string>ECP384</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_PFSMM)">
            <value>
              <string>PFSMM</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_PFS24)">
            <value>
              <string>PFS24</string>
            </value>
          </item>
        </enum>
        <enum id="DHGroup_DropDown" valueName="DHGroup" required="true">
          <item displayName="$(string.dropdown_Group1)">
            <value>
              <string>Group1</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_Group2)">
            <value>
              <string>Group2</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_Group14)">
            <value>
              <string>Group14</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_ECP256)">
            <value>
              <string>ECP256</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_ECP384)">
            <value>
              <string>ECP384</string>
            </value>
          </item>
          <item displayName="$(string.dropdown_Group24)">
            <value>
              <string>Group24</string>
            </value>
          </item>
        </enum>
      </elements>
    </policy>


    <!--  List of Routes  DT-->
    <policy
      name="RoutesDT"
      class="Machine"
      displayName="$(string.Routes_Name)"
      explainText="$(string.Routes_Explain)"
      presentation="$(presentation.Routes)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="Routes" valueName="Routes" required="true" />
      </elements>
    </policy>

    <!--  List of DomainNameInformation DT-->
    <policy
      name="DniDT"
      class="Machine"
      displayName="$(string.Dni_Name)"
      explainText="$(string.Dni_Explain)"
      presentation="$(presentation.Dni)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="Dni" valueName="DomainNameInformation" required="true" />
      </elements>
    </policy>

     <!--  List of TrafficFilters DT-->
    <policy
      name="TrafficFiltersXmlDT"
      class="Machine"
      displayName="$(string.TrafficFiltersXml_Name)"
      explainText="$(string.TrafficFiltersXml_Explain)"
      presentation="$(presentation.TrafficFiltersXml)"
      key="SOFTWARE\Policies\AovpnFromGPO\Devicetunnel"
    >

      <parentCategory ref="DeviceTunnel" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="TrafficFiltersXml" valueName="TrafficFiltersXml" required="true" />
      </elements>
    </policy>

    <!-- ######################  START ALL USER CONNECTION POLICIES  ######################  -->

  
    <!-- Set Eap Config AUC-->
    <policy
      name="EapConfigAUC"
      class="Machine"
      displayName="$(string.EapConfig_Name)"
      explainText="$(string.EapConfig_Explain)"
      presentation="$(presentation.EapConfig)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="EapConfigTextBox" valueName="EapConfig" required="true" />
      </elements>
    </policy>


    <!--  Set DNS-Suffix AUC  -->
    <policy
      name="DNSSuffixAUC"
      class="Machine"
      displayName="$(string.DNSSuffix_Name)"
      explainText="$(string.DNSSuffix_Explain)"
      presentation="$(presentation.DNSSuffix)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <text id="DNSSuffixTextBox" valueName="DNSSuffix" required="true" />
      </elements>
    </policy>

    <!--  DNS-Suffixes for Trusted Network Detection AUC  -->
    <policy
      name="TrustedNetworkDetectionAUC"
      class="Machine"
      displayName="$(string.TrustedNetworkDetection_Name)"
      explainText="$(string.TrustedNetworkDetection_Explain)"
      presentation="$(presentation.TrustedNetworkDetection)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="TrustedNetworks" valueName="TrustedNetworkDetection" required="true" />
      </elements>
    </policy>

    <!--  Enable/Disable DisconnectButton AUC   -->

    <policy
      name="DisableDisconnectButtonAUC"
      class="Machine"
      displayName="$(string.DisableDisconnectButton_Name)"
      explainText="$(string.DisableDisconnectButton_Explain)"
      presentation="$(presentation.DisableDisconnectButton)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
      valueName="DisableDisconnectButton">

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION" />
      <enabledValue>
        <string>true</string>
      </enabledValue>
      <disabledValue>
        <string>false</string>
      </disabledValue>
    </policy>


    <!--  Enable/Disable Advanced Option Button  AUC -->

    <policy
      name="DisableAdvancedOptionsEditButtonAUC"
      class="Machine"
      displayName="$(string.DisableAdvancedOptionsEditButton_Name)"
      explainText="$(string.DisableAdvancedOptionsEditButton_Explain)"
      presentation="$(presentation.DisableAdvancedOptionsEditButton)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
      valueName="DisableAdvancedOptionsEditButton">

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION" />
      <enabledValue>
        <string>true</string>
      </enabledValue>
      <disabledValue>
        <string>false</string>
      </disabledValue>
    </policy>

    <!--  Enable/Disable Class Based Default Route AUC   

    <policy
      name="DisableClassBasedDefaultRouteAUC"
      class="Machine"
      displayName="$(string.DisableClassBasedDefaultRoute_Name)"
      explainText="$(string.DisableClassBasedDefaultRoute_Explain)"
      presentation="$(presentation.DisableClassBasedDefaultRoute)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
      valueName="DisableClassBasedDefaultRoute">

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />

      <enabledValue>
        <string>true</string>
      </enabledValue>
      <disabledValue>
        <string>false</string>
      </disabledValue>
    </policy> -->

    <!--  Enable/Disable Register DNS AUC   -->

    <policy
      name="RegisterDNSAUC"
      class="Machine"
      displayName="$(string.RegisterDNS_Name)"
      explainText="$(string.RegisterDNS_Explain)"
      presentation="$(presentation.RegisterDNS)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
      valueName="RegisterDNS">

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />

      <enabledValue>
        <string>false</string>
      </enabledValue>
      <disabledValue>
        <string>true</string>
      </disabledValue>
    </policy>

    <!--  VPN-Servers  AUC-->
    <policy
      name="ServersAUC"
      class="Machine"
      displayName="$(string.Servers_Name)"
      explainText="$(string.Servers_Explain)"
      presentation="$(presentation.Servers)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <text id="Servers" valueName="Servers" required="true" />
      </elements>
    </policy>


    <!--  List of Routes  AUC-->
    <policy
      name="RoutesAUC"
      class="Machine"
      displayName="$(string.Routes_Name)"
      explainText="$(string.Routes_Explain)"
      presentation="$(presentation.Routes)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="Routes" valueName="Routes" required="true" />
      </elements>
    </policy>

     <!--  List of DomainNameInformation AUC-->
    <policy
      name="DniAUC"
      class="Machine"
      displayName="$(string.Dni_Name)"
      explainText="$(string.Dni_Explain)"
      presentation="$(presentation.Dni)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="Dni" valueName="DomainNameInformation" required="true" />
      </elements>
    </policy>

    <!--  List of TrafficFilters AUC-->
    <policy
      name="TrafficFiltersXmlAUC"
      class="Machine"
      displayName="$(string.TrafficFiltersXml_Name)"
      explainText="$(string.TrafficFiltersXml_Explain)"
      presentation="$(presentation.TrafficFiltersXml)"
      key="SOFTWARE\Policies\AovpnFromGPO\AllUserConnection"
    >

      <parentCategory ref="AllUserConnection" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION" />
      <elements>
        <multiText id="TrafficFiltersXml" valueName="TrafficFiltersXml" required="true" />
      </elements>
    </policy>


  </policies>
</policyDefinitions>