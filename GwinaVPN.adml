<?xml version="1.0" encoding="utf-8"?>
<!--  2024 Anthony Stang  -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Gwina VPN</displayName>
  <description>Group Policy Settings for the Windows native VPN client.

Most settings are only effective if the provided script is used for deployment.
  </description>
  <resources>
    <stringTable>
      <string id="GwinaVPN_Name">GwinaVPN</string>
      <string id="GwinaVPN_Explain">Group Policy Settings for the Windows native VPN client.
      
The policies are only effective if used with Set-GwinaVPN.ps1 available here:
https://github.com/astang0/GwinaVPN/blob/main/Set-GwinaVPN.ps1</string>

      <string id="DeviceTunnel_Name">Devicetunnel</string>
      <string id="DeviceTunnel_Explain">Policies that allow you to create a Microsoft Always On VPN Devicetunnel.

This connection type requires Windows 10/11 Enterprise or Education.</string>

      
      <string id="AllUserConnection_Name">All User Connection</string>
      <string id="AllUserConnection_Explain">Policies that allow you to create a Microsoft Always On VPN User Connection that applies to all users of a device.</string>
      
      <string id="Authentication_Name">Authentication Settings</string>
      <string id="Authentication_Explain">Configure the authentication settings for the VPN connection.</string>
      
      <string id="SUPPORTED_Windows_10_0_NOSERVER_ENTERPRISE_EDUCATION">At least Windows 10 Enterprise or Education</string>
      <string id="SUPPORTED_Windows_11_0_22H2_NOSERVER_ENTERPRISE_EDUCATION">At least Windows 11 22H2 Enterprise or Education</string>
      
      <string id="OptionalSettings_Name">Optional Settings</string>
      <string id="OptionalSettings_Explain">These settings are optional and can be used to further customize the VPN connection.</string>

      <string id="DNSSuffix_Name">Set DNS-Suffix for VPN connection</string>
      <string id="DNSSuffix_Explain">Specify the DNS-Suffix that should be used when connected via the Always On VPN connection.</string>
      
      <string id="TrustedNetworkDetection_Name">Set trusted networks</string>
      <string id="TrustedNetworkDetection_Explain">Specify a list of the DNS-Suffixes of networks where the Always On VPN connection should NOT be established from.

Enter one entry per line.     
      </string>
      <string id="RegisterDNS_Name">Enable DNS registration</string>
      <string id="RegisterDNS_Explain">Allows the VPN client to register it´s IP address with the configured DNS Server. The used DNS zone is configured in the "DNS-Suffix to use when connected" setting.

When using a dual tunnel configuration, it is recommended to to only enable DNS registration for the device tunnel, as the user tunnel is not always active (i.e.: when no user is logged in) and might register an IP address that is not reachable. 

Default: DNS registration is disabled.
      </string>
      <string id="DisableDisconnectButton_Name">Disable Disconnect Button</string>
      <string id="DisableDisconnectButton_Explain">Disables the "Disconnect" button for the VPN connection.

This setting is recommended for device tunnels, as the "Disconnect" button does not work for regular users, which could lead to confusion.
The setting is only effective for Windows 11 22H2 or later.

Default: The button is disabled.
      </string>
      <string id="DisableAdvancedOptionsEditButton_Name">Disable Advanced Options Edit Button</string>
      <string id="DisableAdvancedOptionsEditButton_Explain">Disables the "Advanced Options Edit" button for the VPN connection.

This setting is recommended for device tunnels, as the "Advanced Options Edit" button does not work for regular users, which could lead to confusion.
The setting is only effective for Windows 11 22H2 or later.

Default: The button is disabled.
      </string>
      <string id="DisableClassBasedDefaultRoute_Name">Disable Class Based Default Route</string>
      <string id="DisableClassBasedDefaultRoute_Explain">Disables the usage of class based default routes.

This setting is recommended. 

When class based default routes are disabled, static routes must be specified.

Default: Class based default routes are disabled.
      </string>
      <string id="ShowDeviceTunnelInUI_Name">Show Device Tunnel in UI</string>
      <string id="ShowDeviceTunnelInUI_Explain">Shows the connection status of the Devicetunnel in the connections menu in the task bar.

Default: Device Tunnel status is not shown in UI.
      </string>
      
      
      <string id="Servers_Name">Set VPN server to connect to</string>
      <string id="Servers_Explain">FQDN or IP address of the VPN server the devices should connect to.

Depending on the VPN protocol used, this must match the certificate subject or alternative subject of the servers certificate.

Enter the FQDN or IP address in the first column and the friendly name of the server in the second column. The friendly name is only used for display purposes in the connection center.
Examples:

        vpn01.contoso.com | VPN Server 1
        vpn02.contoso.com | VPN Server 2

Setting multiple servers only makes sense when not using an Always on VPN connection. In that case, the client will only connect to the first server in the list. If that server is not reachable, the client will not try to connect to the next server in the list.
When not using an Always on VPN connection, users can manually select a server to connect to in the connection center. In that case, the client will only try to connect to the selected server, even if it is not the first server in the list.
      </string>

      <string id="EapConfigXml_Name">Set custom EAP Configuration XML</string>
      <string id="EapConfigXml_Explain">To unlock all EAP configuration options that are available in the Security tab of a Windows VPN connection network adapter, you can enter the raw EAP Configuration XML for this connection here.

Using this option will override all other EAP configuration settings in the policy.

To create this EAP configuration, manually create a VPN connection on a test device and configure the EAP settings to your needs.
Once you got the EAP configuration ready, open a Powershell to extract the EAP configuration XML.

Enter the following commands:
$vpn = Get-VPNconnection [Name of configured connection]
$vpn.EapConfigXmlStream.Innerxml

Copy the returned XML data as is into the provided textbox. Since there´s a character limit per line, some line breaks will be necessary.
Add some linebreaks inbetween XML elements so that the configuration fits the textbox. It does not matter between which elements the line breaks are entered.
</string>
 

      <string id="IKEv2Settings_Name">Set custom IKEv2/IPsec settings</string>
      <string id="IKEv2Settings_Explain">Specify the custom cryptography settings for the IKEv2 connection.
      
Minimum Recommendations (requires ECC certificates on the server and client): 
Phase 1 Authentication: SHA256
Phase 1 Encryption: AES_GCM_128
Phase 2 Authentication: SHA256128
Phase 2 Encryption: AES128
PFS Group: ECP256
DH Group: ECP256
      </string>

      <string id="Routes_Name">Set VPN routes</string>
      <string id="Routes_Explain">IP destinations that are reachable through the VPN tunnel.

Entries are specified as IP/PrefixSize in the first column and the route metric in the second column.
Examples:
        
        10.0.14.3/32 | 1
        10.13.5.0/24 | 25

If no route metric is specified, the route metric defaults to 1.

Specify one entry per line. Avoid leading zeros in the IP address.
      </string>

      <string id="Dni_Name">Set domain name information settings</string>
      <string id="Dni_Explain">By default, the Windows VPN-Client will try to use the same DNS server that the VPN server is configured to use.
To change that behavior, specify FQDNs or DNS-Suffixes and corresponding DNS-Servers to use when resolving matching FQDNs (NRPT-Policies). These settings only apply when the connection is active.

Enter domain names in the first column and corresponding DNS servers in the second column.
Examples:

        To match specific host:
        DC01.adatum.com | 192.168.4.3

        To match all hostnames with DNS suffix ".contoso.com" specify multiple DNS-Servers:
        .contoso.com | 192.168.150.9,192.168.150.8

        To specify an exception which causes the specified host to always be resolved through the DNS, don´t specify DNS-Servers:
        FS04.contoso.com

Specify one entry per line. 
</string>

      <string id="TrafficFiltersXml_Name">Set Traffic Filters</string>
      <string id="TrafficFiltersXml_Explain">Set Traffic Filters to implement further access control. 

Enter the Traffic Filter XML into the textbox (up to 50). Using traffic filters will create an implicit deny all rule, meaning that no traffic will be allowed through the VPN connection if it is not specifically allowed through a traffic filter rule. 
</string>

      <string id="ProfileName_Name">Set VPN connection name</string>
      <string id="ProfileName_Explain">Displayname of the VPN-Connection. Users might see this name in the Connection Center.</string>

      <string id="dropdown_MD596">MD596</string>
      <string id="dropdown_SHA196">SHA196</string>
      <string id="dropdown_SHA256128">SHA256128</string>
      <string id="dropdown_GCMAES128">GCMAES128</string>
      <string id="dropdown_GCMAES192">GCMAES192</string>
      <string id="dropdown_GCMAES256">GCMAES256</string>

      <string id="dropdown_DES">DES</string>
      <string id="dropdown_DES3">DES3</string>
      <string id="dropdown_AES128">AES128</string>
      <string id="dropdown_AES192">AES192</string>
      <string id="dropdown_AES256">AES256</string>

      <string id="dropdown_PFS24">PFS24</string>
      <string id="dropdown_PFS2">PFS2</string>
      <string id="dropdown_PFS2048">PFS2048</string>
      <string id="dropdown_ECP256">ECP256</string>
      <string id="dropdown_ECP384">ECP384</string>
      <string id="dropdown_PFSMM">PFSMM</string>
      <string id="dropdown_PFS1">PFS1</string>

      
      <string id="dropdown_MD5">MD5</string>
      <string id="dropdown_SHA1">SHA1</string>
      <string id="dropdown_SHA256">SHA256</string>
      <string id="dropdown_SHA384">SHA384</string>

      <string id="dropdown_Group1">Group1</string>
      <string id="dropdown_Group2">Group2</string>
      <string id="dropdown_Group14">Group14</string>
      <string id="dropdown_Group24">Group24</string>

      <string id="dropdown_AES_GCM_128">AES_GCM_128</string>
      <string id="dropdown_AES_GCM_256">AES_GCM_256</string>

      <string id="AllowedServerNames_Name">Server Validation: Allowed Authentication Server Names</string>
      <string id="AllowedServerNames_Explain">Specify a list of server names or suffix patterns that the client is allowed to connect to for authentication purposes.

Examples: 

      radius
      radius.contoso.com
      *.contoso.com

Enter one entry per line.
If this list is empty, no server name restriction is applied.
</string>

      <string id="TrustedServerRootCAThumbprints_Name">Server Validation: Trusted Server Root CA Thumbprints</string>
      <string id="TrustedServerRootCAThumbprints_Explain">Specify a list of SHA-1 thumbprints of trusted root certification authorities (CAs) that are acceptable issuers of the server certificate.

Examples: 

      06 f1 aa 33 0b 92 7b 75 3a 40 e6 8c df 22 e3 4b cb ef 33 52
      06f1aa330b927b753a40e68cdf22e34bcbef3352
      06F1AA330B927B753A40E68CDF22E34BCBEF3352

Enter one entry per line.      
If this list is empty, all root CAs already trusted by the device are accepted.
</string> 

      <string id="DisableNewServerPrompt_Name">Server Validation: Disable New Server Prompt</string>
      <string id="DisableNewServerPrompt_Explain">Do not prompt the user to authorize new servers or trusted certification authorities.</string>

      <string id="EapTlsCredentialsSource_Name">Client Authentication: EAP-TLS Credential Source</string>
      <string id="EapTlsCredentialsSource_Explain">Specify the credential source to use for EAP-TLS authentication. Either a certificate from the local certificate store or a smart card can be used. If a smart card is used, the user must have a smart card reader and a smart card with a valid certificate for authentication.</string>
      <string id="dropdown_CertificateStore">Certificate from Local Store</string>
      <string id="dropdown_SmartCard">Certificate from Smart Card</string>

      <string id="EapTlsAllowedBaseEKUs_Name">Client Authentication: Allowed Client Certificate EKUs</string>
      <string id="EapTlsAllowedBaseEKUs_Explain">Specify the EKUs that are allowed for client authentication.
      
Client Authentication EKU:
Certificates with the Client Authentication EKU (OID 1.3.6.1.5.5.7.3.2) are allowed for client authentication.

Any Purpose EKU:
Certificates with the Any Purpose EKU (OID 1.3.6.1.4.1.311.10.12.1) are allowed for client authentication.

All-Purpose EKU:
All-Purpose certificates (EKU-field = 0) are allowed for client authentication.
      </string>

      <string id="EapTlsIssuerHash_Name">Client Authentication: Allowed Client Certificate Issuer Hashes</string>
      <string id="EapTlsIssuerHash_Explain">Specify a list of SHA-1 thumbprints of trusted root certification authorities (CAs) that are acceptable issuers of the client certificate for EAP-TLS authentication.

Examples: 

      06 f1 aa 33 0b 92 7b 75 3a 40 e6 8c df 22 e3 4b cb ef 33 52
      06f1aa330b927b753a40e68cdf22e34bcbef3352
      06F1AA330B927B753A40E68CDF22E34BCBEF3352

Enter one entry per line.    
If this list is empty, all root CAs already trusted by the device are accepted.
</string>
    
    </stringTable>



    <presentationTable>

      <presentation id="EapConfigXml">
        <multiTextBox refId="EapConfigXmlTextBox">
          EAP Configuration:
        </multiTextBox>
      </presentation>

      <presentation id="DNSSuffix">
        <textBox refId="DNSSuffixTextBox">
          <label>DNS Suffix:</label>
        </textBox>
      </presentation>

      <presentation id="TrustedNetworkDetection">
        <listBox refId="TrustedNetworkDetection">Trusted Network Suffixes:</listBox>
      </presentation>

      <presentation id="DisableDisconnectButton">
      </presentation>

      <presentation id="ShowDeviceTunnelInUI">
      </presentation>

      <presentation id="DisableClassBasedDefaultRoute">
      </presentation>

      <presentation id="DisableAdvancedOptionsEditButton">
      </presentation>

      <presentation id="RegisterDNS">
      </presentation>

      <presentation id="Servers">
        <text>Enter VPN servers here:</text>
        <listBox refId="Servers">VPN Servers:</listBox>
      </presentation>

      <presentation id="IKEv2Settings">
        <dropdownList refId="IntegrityCheckMethod_DropDown" noSort="true">Phase 1 Authentication Method:</dropdownList>
        <dropdownList refId="EncryptionMethod_DropDown" noSort="true">Phase 1 Encryption Method:</dropdownList>
        <dropdownList refId="AuthenticationTransformConstants_DropDown" noSort="true">Phase 2 Authentication Method:</dropdownList>
        <dropdownList refId="CipherTransformConstants_DropDown" noSort="true">Phase 2 Encryption Method:</dropdownList>
        <dropdownList refId="PfsGroup_DropDown" noSort="true">PFS Group:</dropdownList>
        <dropdownList refId="DHGroup_DropDown" noSort="true">Diffie-Hellmann Group:</dropdownList>
      </presentation>

      <presentation id="Routes">
        <text>Enter Routes here:</text>
        <listBox refId="Routes">Routes:</listBox>
      </presentation>

      <presentation id="Dni">
        <text>Enter Domain Name Information here:</text>
        <listBox refId="Dni">DNI List:</listBox>
      </presentation>

      <presentation id="TrafficFiltersXml">
        <multiTextBox refId="TrafficFiltersXml">
          Traffic Filters:
        </multiTextBox>
      </presentation>

      <presentation id="ProfileName">
        <textBox refId="ProfileName">
          <label>Profile Name:</label>
        </textBox>
      </presentation>

      <presentation id="DisableNewServerPrompt">
      </presentation>


      <presentation id="AllowedServerNames">
        <text>Allowed server names (one pattern per line, e.g. *.contoso.com):</text>
        <listBox refId="AllowedServerNames">Allowed server names</listBox>
      </presentation>

      <presentation id="TrustedServerRootCAThumbprints">
        <text>Trusted Root Certification Authorities (one SHA-1 thumbprint per line):</text>
        <listBox refId="TrustedServerRootCAThumbprints">Trusted Root CA thumbprints</listBox>
      </presentation>

      <presentation id="EapTlsCredentialsSource">
        <dropdownList refId="EapTlsCredentialsSource_DropDown" noSort="true">Credential Source:</dropdownList>
      </presentation>

      <presentation id="EapTlsAllowAllPurposeCerts">
      </presentation>

      <presentation id="EapTlsIssuerHash">
        <text>EAP-TLS Issuer Hashes (one hash per line):</text>
        <listBox refId="EapTlsIssuerHash">EAP-TLS Issuer Hashes</listBox>
      </presentation>

      <presentation id="EapTlsAllowedBaseEKUs">
        <checkBox refId="EapTlsAllowClientAuthenticationEKU" defaultChecked="true">Include Client Authentication EKU</checkBox>
        <checkBox refId="EapTlsAllowAnyPurposeEKU" defaultChecked="false">Include Any Purpose EKU</checkBox>
        <checkBox refId="EapTlsAllowAllPurposeEKU" defaultChecked="false">Include All-Purpose EKU</checkBox>
      </presentation>

    </presentationTable>
  </resources>
</policyDefinitionResources>
